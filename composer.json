{
    "name": "qubus/filesystem",
    "type": "library",
    "description": "Filesystem component wrapper for League/Flysystem.",
    "keywords": [
        "file",
        "filesystem",
        "flysystem",
        "directory"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Joshua Parker",
            "email": "joshua@joshuaparker.dev"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-ftp": "*",
        "league/flysystem": "^3",
        "league/flysystem-aws-s3-v3": "^3",
        "league/flysystem-ftp": "^3",
        "league/flysystem-memory": "^3",
        "league/flysystem-sftp-v3": "^3",
        "qubus/config": "^4",
        "qubus/exception": "^4"
    },
    "require-dev": {
        "qubus/qubus-coding-standard": "^2"
    },
    "autoload": {
        "psr-4": {
            "Qubus\\FileSystem\\": ""
        }
    },
    "scripts": {
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "pest"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
